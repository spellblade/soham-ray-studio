# Copy to .env for local work. Never commit real values.
# Production: set these in the Vercel project, not in git.

# Neon pooled connection string (required for a lasting Studio / inbox).
# Prefer sslmode=verify-full (sslmode=require is rewritten at runtime).
DATABASE_URL=

# Better Auth cookie signing (optional identity — does not unlock Studio)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-project.vercel.app

# Set false to hide Google / X / email identity UI. Studio still uses its own key.
VITE_AUTH_ENABLED=true

# Injected automatically on Grok / Vercel preview. Leave blank for a self-hosted deploy.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
